\newcommand<>{\keyword}[1]{\textcolor{gray}{#1}}
\newcommand<>{\keywordb}[1]{\textbf{\textcolor{gray}{#1}}}

% TITLE PAGE (1st Page)
\defbeamertemplate*{title page}{hpi}[1][]
{
	\raggedright

	\usebeamerfont{title}\usebeamercolor[fg]{title}
	\inserttitle\par

	\vspace*{-1.7\baselineskip}
	\raggedleft
	\includegraphics[height=1.5\baselineskip]{logos/hpi-logo-black}

	\raggedright
	\vspace{17mm}
    \usebeamerfont{author}
    \insertauthor

    \usebeamerfont{institute}
    \insertinstitute

    \bigskip
    \usebeamerfont{data}
    \insertdate
}


% FRAME TITLE (Header)
\defbeamertemplate*{frametitle}{hpi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, ht=8mm, dp=1mm, wd=\paperwidth]{frametitle}
		\usebeamerfont{frametitle}\insertframetitle{}
	\end{beamercolorbox}
	\nointerlineskip
	\vspace{-16mm}
	\begin{beamercolorbox}[right, rightskip=8mm, ht=16mm, dp=1mm, wd=\paperwidth]{}
	    \includegraphics[height=5mm]{logos/hpi-logo-black}
	\end{beamercolorbox}
	\vspace{-2mm}
}


% FOOT LINE (Footer)
\defbeamertemplate*{footline}{cgi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, rightskip=8mm, dp=2mm, wd=\paperwidth]{footline}
		\insertpagenumber \quad \insertshorttitle 
		\hfill \insertauthor %\insertsubtitle~\ifx\insertsectionhead\empty\else\slash~\insertsectionhead\fi
	\end{beamercolorbox}%
}

\setbeamertemplate{navigation symbols}{}

